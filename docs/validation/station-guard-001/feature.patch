+    assert cmd.left == pytest.approx(-.09) and cmd.right == pytest.approx(-.09)
+    for invalid in [ControlCommand(left=math.nan), ControlCommand(lateral=.1), ControlCommand(left=1.1)]:
+        with pytest.raises(ValueError):
