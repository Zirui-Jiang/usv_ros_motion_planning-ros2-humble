+    return SetMission.Request(mode=mode, latitude=lat, longitude=lon, heading_deg=heading,
+                              speed=.5, position_tolerance=.5, watch_radius=10.,
+                              orbit_radius=10., clockwise=True, laps=0, duration=0.)
