{
    "folders": [
        {
            "path": "."
        }
    ],
    "settings": {
        "files.watcherExclude": {
            "**/.git/objects/**": true,
            "**/.git/subtree-cache/**": true,
            "${workspaceFolder}/.cache/**": true,
            "${workspaceFolder}/build/**": true,
            "${workspaceFolder}/devel/**": true
        },
        "clangd.path": "/usr/bin/clangd-19",
        "clangd.arguments": [
            "--all-scopes-completion",
            "--background-index",
            "--clang-tidy",
            "--compile-commands-dir=${workspaceFolder}/build",
            "--completion-style=detailed",
            "--fallback-style=Google",
            "--function-arg-placeholders",
            "--header-insertion=iwyu",
            "--j=4",
            "--malloc-trim",
            "--pch-storage=memory",
            "--query-driver=/usr/bin/g++*,/usr/bin/gcc*,/usr/bin/c++*,/usr/bin/cc*,/usr/bin/clang*"
        ],
        "clang-format.executable": "/usr/bin/clang-format-19",
        "python.pythonPath": "/usr/bin/python3",
        "editor.formatOnSave": true,
        "editor.formatOnSaveMode": "file",
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
        "[cpp]": {
            "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
            "editor.formatOnSave": true
        },
        "[c]": {
            "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
            "editor.formatOnSave": true
        },
        "cSpell.enableFiletypes": [
            "cuda",
            "cuda-cpp"
        ],
        "files.associations": {
            "array": "cpp",
            "atomic": "cpp",
            "hash_map": "cpp",
            "hash_set": "cpp",
            "strstream": "cpp",
            "*.tcc": "cpp",
            "bitset": "cpp",
            "cctype": "cpp",
            "chrono": "cpp",
            "clocale": "cpp",
            "cmath": "cpp",
            "codecvt": "cpp",
            "complex": "cpp",
            "condition_variable": "cpp",
            "csignal": "cpp",
            "cstdarg": "cpp",
            "cstddef": "cpp",
            "cstdint": "cpp",
            "cstdio": "cpp",
            "cstdlib": "cpp",
            "cstring": "cpp",
            "ctime": "cpp",
            "cwchar": "cpp",
            "cwctype": "cpp",
            "deque": "cpp",
            "list": "cpp",
            "unordered_map": "cpp",
            "unordered_set": "cpp",
            "vector": "cpp",
            "exception": "cpp",
            "string_view": "cpp",
            "fstream": "cpp",
            "functional": "cpp",
            "future": "cpp",
            "initializer_list": "cpp",
            "iomanip": "cpp",
            "iosfwd": "cpp",
            "iostream": "cpp",
            "istream": "cpp",
            "limits": "cpp",
            "memory": "cpp",
            "mutex": "cpp",
            "new": "cpp",
            "numeric": "cpp",
            "optional": "cpp",
            "ostream": "cpp",
            "ratio": "cpp",
            "sstream": "cpp",
            "stdexcept": "cpp",
            "streambuf": "cpp",
            "system_error": "cpp",
            "thread": "cpp",
            "tuple": "cpp",
            "type_traits": "cpp",
            "typeindex": "cpp",
            "typeinfo": "cpp",
            "utility": "cpp",
            "*.ipp": "cpp",
            "any": "cpp",
            "cfenv": "cpp",
            "cinttypes": "cpp",
            "forward_list": "cpp",
            "algorithm": "cpp",
            "iterator": "cpp",
            "map": "cpp",
            "memory_resource": "cpp",
            "random": "cpp",
            "regex": "cpp",
            "set": "cpp",
            "string": "cpp",
            "scoped_allocator": "cpp",
            "valarray": "cpp",
            "variant": "cpp",
            "*.txt": "perl"
        }
    },
    "extensions": {
        "recommendations": [
            "eamodio.gitlens",
            "llvm-vs-code-extensions.vscode-clangd",
            "ms-python.python",
            "ms-vscode-remote.vscode-remote-extensionpack",
            "ms-vscode.cmake-tools",
            "redhat.vscode-yaml",
            "streetsidesoftware.code-spell-checker",
            "zxh404.vscode-proto3"
        ]
    }
}