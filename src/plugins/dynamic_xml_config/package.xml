<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<!-- 动态 XML 场景生成包，声明 YAML 解析与 ROS Python 运行依赖。 -->
<package format="3">
  <name>dynamic_xml_config</name>
  <version>0.2.0</version>
  <description>
    dynamic xml configure
  </description>

  <maintainer email="913982779@qq.com">Winter</maintainer>

  <license>BSD</license>

  <author email="913982779@qq.com">Winter</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <!-- 导出 ament 构建类型及下方列出的包资源信息，供 ROS 2 工具发现和使用。 -->
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
