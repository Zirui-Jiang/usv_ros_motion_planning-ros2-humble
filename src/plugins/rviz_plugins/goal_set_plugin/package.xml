<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<!-- 自定义 RViz 目标工具包，声明消息、pluginlib、RViz 与 tf2 依赖。 -->
<package format="3">
    <name>goal_set_plugin</name>
    <version>0.0.0</version>
    <description>Rviz custom goal setting tool</description>
    <maintainer email="913982779@qq.com">Winter</maintainer>
    <license>TODO</license>

    <buildtool_depend>ament_cmake</buildtool_depend>

    <depend>rclcpp</depend>
    <depend>geometry_msgs</depend>
    <depend>pluginlib</depend>
    <depend>rviz_common</depend>
    <depend>rviz_default_plugins</depend>
    <depend>rviz_rendering</depend>
    <depend>std_msgs</depend>
    <depend>tf2</depend>

    <exec_depend>rviz2</exec_depend>
    <exec_depend>qt_dotgraph</exec_depend>

    <!-- 导出 ament 构建类型及下方列出的包资源信息，供 ROS 2 工具发现和使用。 -->
    <export>
        <build_type>ament_cmake</build_type>
    </export>
</package>
