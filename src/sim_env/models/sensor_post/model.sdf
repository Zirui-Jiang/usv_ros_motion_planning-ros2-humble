<?xml version="1.0"?>
<!-- Gazebo 模型 sensor_post 的结构描述；碰撞体、外观和惯性分别定义，网格纹理仍由资源文件提供。 -->
<sdf version="1.6">
  <model name="sensor_post">
    <pose>0 0 0 1.57 0 0</pose>
    <!-- Post link -->
    <link name="post_link">
      <!-- 外观几何与材质只负责显示，不能据此认定物理碰撞尺寸。 -->
      <visual name="post_visual">
        <pose>0 -0.2515 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://sensor_post/mesh/sensor_post.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <!-- 碰撞几何参与物理接触检测，不一定与显示网格完全相同。 -->
      <collision name="post_collision">
        <pose>0 0 0 1.57 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.0076</radius>
            <length>0.503</length>
          </cylinder>
        </geometry>
      </collision>
      <!-- 质量和惯性张量影响动力学；与仅用于显示的网格外观分别配置。 -->
      <inertial>
        <pose>0 0 0 1.57 0 0</pose>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.010549261666667</ixx>
          <iyy>0.010549261666667</iyy>
          <izz>0.000014440000000</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
    </link>

    <!-- Arm link -->
    <link name="arm_link">
      <pose>0 0.2 0.03 0 0 0</pose>
      <visual name="arm_visual">
        <pose>0 -0.016 -0.035 0 0 0 </pose>
        <geometry>
          <mesh> 
            <uri>model://sensor_post/mesh/sensor_post_arm.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name="arm_collision">
        <pose>0 0 0 -0.15 0 0 </pose>
        <geometry>
          <cylinder>
            <radius>0.008</radius>
            <length>0.065</length>
          </cylinder>
        </geometry>
      </collision>
      <inertial>
        <pose>0 0 0 -0.15 0 0 </pose>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.00003680833</ixx>
          <iyy>0.00003680833</iyy>
          <izz>0.00000320000</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia> 
      </inertial>
    </link>

    <!-- Post to arm joint -->
    <joint name="post_to_arm_joint" type="fixed">
      <parent>post_link</parent>
      <child>arm_link</child>
      <pose>0 0 -0.03 0 0 0</pose>
    </joint>

  </model>
</sdf>
