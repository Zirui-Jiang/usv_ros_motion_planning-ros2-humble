<?xml version="1.0"?>
<!-- Gazebo 模型 3d_lidar 的结构描述；碰撞体、外观和惯性分别定义，网格纹理仍由资源文件提供。 -->
<sdf version="1.6">
  <model name="3d_lidar">
    <link name="3d_lidar_link">
      <!-- 外观几何与材质只负责显示，不能据此认定物理碰撞尺寸。 -->
      <visual name="3d_lidar_visual">
      <pose>0 0 -0.035 0 0 0</pose>
        <geometry>
          <mesh> 
            <uri>model://3d_lidar/mesh/3d_lidar.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <!-- 碰撞几何参与物理接触检测，不一定与显示网格完全相同。 -->
      <collision name="3d_lidar_collision">
        <geometry>
          <cylinder>
            <radius>0.055</radius>
            <length>0.075</length>
          </cylinder>
        </geometry>
      </collision>
      <!-- 质量和惯性张量影响动力学；与仅用于显示的网格外观分别配置。 -->
      <inertial>
        <mass>1</mass>
        <inertia>
          <ixx>0.00109375</ixx>
          <iyy>0.00109375</iyy>
          <izz>0.00125</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
    </link>
  </model>
</sdf>
