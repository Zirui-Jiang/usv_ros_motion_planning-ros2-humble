<?xml version="1.0"?>
<!-- IMU 传感器模板，描述安装位姿和输出配置；普通导航入口当前关闭该传感器。 -->
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <!-- 定义可复用宏；调用时替换参数并展开为实际 URDF/SDF 元素。 -->
  <xacro:macro name="otter_imu" params="name:=imu x:=0 y:=0 z:=0 R:=0 P:=0 Y:=0">
    <link name="${name}_link">
      <!-- 外观几何与材质只负责显示，不能据此认定物理碰撞尺寸。 -->
      <visual name="${name}_visual">>
        <geometry>
          <box size="0.05 0.025 0.005" />
        </geometry>
        <material name="${name}_visual_material">
          <color rgba="1.0 0.0 00 1.0" />
        </material>
      </visual>
    </link>
    <joint name="${name}_joint" type="fixed">
      <origin xyz="${x} ${y} ${z}" rpy="${R} ${P} ${Y}"/>
      <parent link="base_link"/>
      <child link="${name}_link"/>
    </joint>
    <gazebo reference="${name}_link">
      <!-- ROS 2 gazebo_ros_pkgs IMU sensor -->
      <!-- 加载指定动态库并传入参数；具体数值处理由对应插件源码完成。 -->
      <plugin name="imu_plugin_${name}" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <namespace>/${namespace}</namespace>
          <remapping>~/out:=${sensor_namespace}imu/imu/data</remapping>
        </ros>
        <update_rate>15.0</update_rate>
        <imu_name>${name}</imu_name>
        <frame_name>${namespace}/${name}_link</frame_name>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
        <gaussian_noise>0.0</gaussian_noise>
        <accelerometer>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.0</stddev>
            <bias_mean>0.0</bias_mean>
            <bias_stddev>0.0</bias_stddev>
          </noise>
        </accelerometer>
        <gyroscope>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.0</stddev>
            <bias_mean>0.0</bias_mean>
            <bias_stddev>0.0</bias_stddev>
          </noise>
        </gyroscope>
      </plugin>
    </gazebo>
  </xacro:macro>
</robot>
