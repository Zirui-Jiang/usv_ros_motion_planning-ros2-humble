<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <!-- Simulated IMU (ROS 2 gazebo_ros_pkgs IMU sensor, otter-style).
       visual_only: instantiate the link/mesh without the gazebo plugin,
       for looks only, e.g. when localization comes from fake_localization. -->
  <xacro:macro name="wamv_imu" params="name:=imu_wamv x:=0.3 y:=-0.2 z:=1.3 R:=0 P:=0 Y:=0 update_rate:=15 visual_only:=0">
    <link name="${name}_link">
      <visual name="${name}_visual">
        <geometry>
          <box size="0.05 0.025 0.005" />
        </geometry>
        <material name="${name}_visual_material">
          <color rgba="1.0 0.0 00 1.0"/>
        </material>
      </visual>
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.000083" ixy="0.0" ixz="0.0" iyy="0.000083" iyz="0.0" izz="0.0125"/>
      </inertial>
    </link>
    <joint name="${name}_joint" type="fixed">
      <origin xyz="${x} ${y} ${z}" rpy="${R} ${P} ${Y}"/>
      <parent link="base_link"/>
      <child link="${name}_link"/>
    </joint>
    <xacro:unless value="${visual_only}">
      <gazebo reference="${name}_link">
        <!-- ROS 2 gazebo_ros_pkgs IMU sensor -->
        <plugin name="imu_plugin_${name}" filename="libgazebo_ros_imu_sensor.so">
          <ros>
            <namespace>/${namespace}</namespace>
            <remapping>~/out:=${sensor_namespace}imu/imu/data</remapping>
          </ros>
          <update_rate>${update_rate}</update_rate>
          <imu_name>${name}</imu_name>
          <frame_name>${namespace}/${name}_link</frame_name>
          <initial_orientation_as_reference>false</initial_orientation_as_reference>
          <gaussian_noise>0.0</gaussian_noise>
          <accelerometer>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.0</stddev>
              <bias_mean>0.0</bias_mean>
              <bias_stddev>0.0</bias_stddev>
            </noise>
          </accelerometer>
          <gyroscope>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.0</stddev>
              <bias_mean>0.0</bias_mean>
              <bias_stddev>0.0</bias_stddev>
            </noise>
          </gyroscope>
        </plugin>
      </gazebo>
    </xacro:unless>
  </xacro:macro>
</robot>
