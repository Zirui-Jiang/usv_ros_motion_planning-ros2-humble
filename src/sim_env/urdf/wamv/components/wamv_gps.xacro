<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <!-- Simulated GPS (ROS 2 gazebo_ros_pkgs GPS sensor, otter-style).
       visual_only: instantiate the link/mesh without the gazebo plugin,
       for looks only, e.g. when localization comes from fake_localization. -->
  <xacro:macro name="wamv_gps" params="name:=gps x:=0.3 y:=0 z:=1.3
               R:=0 P:=0 Y:=0 update_rate:=15 visual_only:=0">
    <link name="${name}_link">
      <visual name="${name}_visual">
        <geometry>
          <mesh filename="package://sim_env/meshes/wamv/gps/mesh/gps.dae"/>
        </geometry>
      </visual>
      <collision name="${name}_collision_base">
        <origin xyz="0 0 0.025" rpy="0 0 0" />
        <geometry>
          <cylinder length="0.05" radius="0.015" />
        </geometry>
      </collision>
      <collision name="${name}_collision_antenna">
        <origin xyz="0 0 0.11" rpy="0 0 0" />
        <geometry>
          <cylinder length="0.1" radius="0.15" />
        </geometry>
      </collision>
      <inertial>
        <mass value="1"/>
        <inertia ixx="0.006458" ixy="0.0" ixz="0.0"
       iyy="0.006458" iyz="0.0" izz="0.01125"/>
      </inertial>
    </link>
    <joint name="${name}_joint" type="fixed">
      <origin xyz="${x} ${y} ${z}" rpy="${R} ${P} ${Y}" />
      <parent link="base_link" />
      <child link="${name}_link" />
    </joint>
    <xacro:unless value="${visual_only}">
      <gazebo reference="${name}_link">
        <!-- ROS 2 gazebo_ros_pkgs GPS sensor (navsat) -->
        <plugin name="gps_plugin_${name}" filename="libgazebo_ros_gps_sensor.so">
          <ros>
            <namespace>/${namespace}</namespace>
            <remapping>~/out:=${sensor_namespace}gps/gps/fix</remapping>
          </ros>
          <update_rate>${update_rate}</update_rate>
          <gaussian_noise>0.0</gaussian_noise>
          <frame_name>${namespace}/${name}_link</frame_name>
        </plugin>
      </gazebo>
    </xacro:unless>
  </xacro:macro>
</robot>
