<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <!-- Planar lidar (ROS 2 gazebo_ros ray sensor, follows the otter lidar
       layout: plain link names + robot_state_publisher frame_prefix give
       <namespace>/lidar_link, the scan topic feeds the mapping node and the
       costmap obstacle layer). -->
  <xacro:macro name="wamv_multibeam_laser" params="name x:=0.5 y:=0 z:=1.35 R:=0 P:=0 Y:=0 min_range:=1.2 max_range:=25 visualize:=false">
    <link name="${name}_link">
      <visual name="${name}_visual">
        <origin xyz="0 0 -0.05"/>
        <geometry>
          <cylinder radius="0.025" length="0.1" />
        </geometry>
        <material name="${name}_visual_material">
          <color rgba="0.5 1.0 0.5 1.0" />
        </material>
      </visual>
    </link>
    <joint name="${name}_joint" type="fixed">
      <origin xyz="${x} ${y} ${z}" rpy="${R} ${P} ${Y}" />
      <parent link="base_link" />
      <child link="${name}_link" />
    </joint>
    <gazebo reference="${name}_link">
      <sensor type="ray" name="lidar_${name}">
        <update_rate>15</update_rate>
        <visualize>${visualize}</visualize>
        <ray>
          <scan>
            <horizontal>
              <samples>2000</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265359</min_angle>
              <max_angle>3.14159265359</max_angle>
            </horizontal>
          </scan>
          <range>
            <!-- Minimum distance of the beam -->
            <min>${min_range}</min>
            <!-- Maximum distance of the beam -->
            <max>${max_range}</max>
            <!-- Linear resolution of the beam -->
            <resolution>0.03</resolution>
          </range>
        </ray>
        <!-- ROS 2 gazebo_ros_pkgs ray sensor (laser scan output) -->
        <plugin name="lidar" filename="libgazebo_ros_ray_sensor.so">
          <ros>
            <!-- remap to the topic used by the mapping and costmap nodes -->
            <namespace>/${namespace}</namespace>
            <remapping>~/out:=${sensor_namespace}lidars/${name}/scan</remapping>
          </ros>
          <output_type>sensor_msgs/LaserScan</output_type>
          <frame_name>${namespace}/${name}_link</frame_name>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
