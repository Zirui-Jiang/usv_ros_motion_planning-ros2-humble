<?xml version="1.0"?>
<!-- usv_decision 包清单：声明普通导航任务管理和异步路径/轨迹规划节点所需的构建、运行及测试依赖。 -->
<package format="3">
  <name>usv_decision</name>
  <version>0.1.0</version>
  <description>Ordinary navigation task ownership and path/trajectory planning.</description>
  <maintainer email="913982779@qq.com">Winter</maintainer>
  <license>BSD</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>usv_navigation</exec_depend>
  <exec_depend>usv_navigation_interfaces</exec_depend>
  <exec_depend>common</exec_depend>
  <exec_depend>path_planner</exec_depend>
  <exec_depend>path_processor</exec_depend>
  <exec_depend>trajectory_planner</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>rosgraph_msgs</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
