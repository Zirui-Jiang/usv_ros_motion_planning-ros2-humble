<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<!-- trajectory_planner 包清单：声明LOS 轨迹生成、圆航线与八字段插值所需的构建、运行及测试依赖。 -->
<package format="3">
  <name>trajectory_planner</name>
  <version>0.1.0</version>
  <description>Python LOS trajectory algorithms, independent of ROS callbacks.</description>

  <maintainer email="913982779@qq.com">Winter</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>common</exec_depend>
