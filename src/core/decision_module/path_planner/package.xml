<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<!-- path_planner 包清单：声明A*/Dijkstra/GBFS 栅格规划和路径几何工具所需的构建、运行及测试依赖。 -->
<package format="3">
  <name>path_planner</name>
  <version>0.1.0</version>
  <description>ROS-independent Python grid path planning algorithms</description>

  <maintainer email="913982779@qq.com">winter</maintainer>

  <license>GPL3</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>common</exec_depend>
  <exec_depend>path_processor</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
