<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<!-- controller 包清单：声明Otter PID、LQR 与定点保持纯 Python 控制算法所需的构建、运行及测试依赖。 -->
<package format="3">
  <name>controller</name>
  <version>0.1.0</version>
  <description>Pure Python Otter PID and LQR algorithms.</description>

  <maintainer email="913982779@qq.com">winter</maintainer>

  <license>GPL3</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>common</exec_depend>
  <exec_depend>trajectory_planner</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
