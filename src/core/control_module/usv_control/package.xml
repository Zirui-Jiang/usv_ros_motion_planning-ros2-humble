<?xml version="1.0"?>
<!-- usv_control 包清单：声明普通导航控制节点及推进输出适配器所需的构建、运行及测试依赖。 -->
<package format="3">
  <name>usv_control</name>
  <version>0.1.0</version>
  <description>Ordinary navigation control and sole propulsion output adapter.</description>
  <maintainer email="913982779@qq.com">Winter</maintainer>
  <license>BSD</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>usv_navigation</exec_depend>
  <exec_depend>usv_navigation_interfaces</exec_depend>
  <exec_depend>common</exec_depend>
  <exec_depend>controller</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>rosgraph_msgs</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
